{
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://reto-tecnico-api.onrender.com/api/:path*" },
    { "source": "/oauth2/:path*", "destination": "https://reto-tecnico-api.onrender.com/oauth2/:path*" },
    { "source": "/login/:path*", "destination": "https://reto-tecnico-api.onrender.com/login/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}